# Supabase público (pode chegar ao browser)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_ANON_KEY

# Somente servidor. Nunca use NEXT_PUBLIC_ neste segredo.
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY

# Opcional: usado apenas pelo Drizzle CLI para gerar/aplicar migrations direto no Postgres.
# Para o fluxo pelo SQL Editor do Supabase, pode ficar vazio.
DATABASE_URL=postgresql://postgres:SENHA@HOST:5432/postgres?sslmode=require

# URL pública do sistema usada nos convites/callbacks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
