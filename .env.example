# Supabase público (pode chegar ao browser; a segurança depende das políticas RLS)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SEU_VALOR

# Somente servidor. Esta chave ignora RLS: nunca use NEXT_PUBLIC_ nem envie ao Git.
SUPABASE_SECRET_KEY=sb_secret_SEU_VALOR

# Compatibilidade temporária para projetos que ainda usam as chaves antigas.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_ANON_KEY_LEGADO
# SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY_LEGADO

# Opcional: usado apenas pelo Drizzle CLI para gerar/aplicar migrations direto no Postgres.
# Para o fluxo pelo SQL Editor do Supabase, pode ficar vazio.
DATABASE_URL=postgresql://postgres:SENHA@HOST:5432/postgres?sslmode=require

# URL pública usada nos convites, callbacks e metadados.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Use "hostinger" no build de produção para gerar o servidor Node sem plugins Cloudflare.
DEPLOY_TARGET=hostinger
